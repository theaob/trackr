datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  avatarUrl      String?
  role           String        @default("Developer")
  passwordHash   String?
  authProvider   String        @default("LOCAL") // "LOCAL", "SSO"
  ssoSubjectId   String?
  canCreateProjects Boolean    @default(false)
  isInstanceAdmin   Boolean    @default(false)
  // Part of every session cookie. Bumping it (password change, "sign out
  // everywhere") invalidates every cookie issued before.
  sessionVersion    Int        @default(0)
  assignedIssues Issue[]       @relation("Assignee")
  reportedIssues Issue[]       @relation("Reporter")
  comments       Comment[]
  activityLogs   ActivityLog[]
  watchedIssues  Watcher[]
  uploadedAttachments Attachment[]
  ledComponents  Component[]   @relation("ComponentLead")
  worklogs       Worklog[]
  notifications       Notification[]
  ledProjects         Project[]
  projectMembers      ProjectMember[]
  personalAccessTokens PersonalAccessToken[]
  createdAt           DateTime      @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?
  // "SCRUM" (sprints, a board scoped to the active one) or "KANBAN" (no
  // sprints, the board is every non-backlog issue in continuous flow).
  boardType   String   @default("SCRUM")
  // Grants VIEWER (read-only) access to visitors with no session. Off by
  // default: a project is private until someone deliberately publishes it.
  allowAnonymousViewers Boolean @default(false)
  leadId      String?
  lead        User?    @relation(fields: [leadId], references: [id])
  members     ProjectMember[]
  issues       Issue[]
  sprints      Sprint[]
  versions     Version[]
  customFields CustomField[]
  webhooks     Webhook[]
  workflowStatuses    WorkflowStatus[]
  workflowTransitions WorkflowTransition[]
  labels       Label[]
  components   Component[]
  customRoles  CustomRole[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A sub-team or subsystem within a project (e.g. "Backend API", "Mobile
// App"), admin-defined in Project Settings -- unlike Label, an issue can only
// pick from the project's existing set, never create one inline.
model Component {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  leadId      String?
  lead        User?    @relation("ComponentLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues      IssueComponent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model IssueComponent {
  id          String    @id @default(cuid())
  issueId     String
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([issueId, componentId])
  @@index([issueId])
  @@index([componentId])
}

// Free-text tags, scoped per project like Jira's. No color or description --
// just a name, created the first time anyone types it on an issue.
model Label {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  issues    IssueLabel[]
  createdAt DateTime     @default(now())

  @@unique([projectId, name])
  @@index([projectId])
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([issueId])
  @@index([labelId])
}

// An opt-in subscription: a user who wants notifications for an issue they
// aren't the assignee of. The assignee and @mentioned users are notified
// regardless of this table.
model Watcher {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, userId])
  @@index([issueId])
  @@index([userId])
}

// A file uploaded to an issue. The bytes live on disk under the data
// directory (see lib/attachmentStorage.ts), keyed by storedName -- a random
// name independent of the user-supplied fileName, which is never trusted as
// a path segment. mimeType is what the uploader's browser reported; the
// download route does not trust it for deciding whether to render content
// inline, only for image previews from a fixed allow-list.
model Attachment {
  id           String   @id @default(cuid())
  issueId      String
  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([issueId])
}

// A project's own set of issue statuses. Issue.status stores the status
// NAME (a plain string, unchanged) rather than a foreign key: SQLite plus a
// db-push-only deploy model makes adding a required relational column risky
// once rows exist, and a name lets an unconfigured project keep using the
// same "BACKLOG"/"TODO"/... strings it always has. Renaming a status cascades
// across existing issues in the same transaction instead.
model WorkflowStatus {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  category  String   // "TODO" | "IN_PROGRESS" | "DONE"
  // Excluded from the board; lives in the Backlog view instead. Orthogonal to
  // category -- the default "Backlog" status is category TODO *and* isBacklog.
  isBacklog Boolean  @default(false)
  color     String   @default("#6B7280")
  order     Int      @default(0)
  wipLimit  Int?
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, order])
}

// A single allowed "from status -> to status" move. Absence of a row means
// the move is refused, on every path that changes status (the detail modal,
// board drag-and-drop, the API), not just the ones with client-side UI for it.
model WorkflowTransition {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId    String
  from      WorkflowStatus @relation("TransitionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        WorkflowStatus @relation("TransitionTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([projectId])
}

model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String      @default("MEMBER") // "ADMIN", "MEMBER", "VIEWER", or custom role name
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([customRoleId])
}

model CustomRole {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#0052cc")
  permissions String   // JSON array of ProjectPermission[]
  members     ProjectMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  status    String    @default("FUTURE") // "FUTURE", "ACTIVE", "COMPLETED"
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Version {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("UNRELEASED") // "UNRELEASED", "RELEASED", "ARCHIVED"
  startDate   DateTime?
  releaseDate DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
}

model CustomField {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("TEXT") // "TEXT", "NUMBER", "SELECT", "MULTI_SELECT", "CHECKBOX", "DATE", "URL"
  options     String?  // JSON string array of options for SELECT / MULTI_SELECT
  required    Boolean  @default(false)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  issueId       String
  issue         Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([issueId, customFieldId])
  @@index([issueId])
  @@index([customFieldId])
}

model Issue {
  id          String        @id @default(cuid())
  key         String        @unique
  title       String
  description String?
  type        String        @default("TASK") // "EPIC", "STORY", "TASK", "BUG", "SUBTASK"
  priority    String        @default("MEDIUM") // "LOWEST", "LOW", "MEDIUM", "HIGH", "HIGHEST"
  status      String        @default("TODO") // "BACKLOG", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE"
  order       Int           @default(0)
  storyPoints Int?
  originalEstimateSeconds  Int?
  remainingEstimateSeconds Int?
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  versionId   String?
  version     Version?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?         @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  String?
  reporter    User?         @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Issue?        @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Issue[]       @relation("IssueHierarchy")
  comments    Comment[]
  activityLogs ActivityLog[]
  customFieldValues CustomFieldValue[]
  linksAsSource IssueLink[] @relation("IssueLinkSource")
  linksAsTarget IssueLink[] @relation("IssueLinkTarget")
  labels      IssueLabel[]
  watchers    Watcher[]
  attachments Attachment[]
  components  IssueComponent[]
  worklogs    Worklog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([projectId, versionId])
  @@index([projectId, createdAt])
  @@index([versionId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([type])
}

// A directional relationship between two issues, e.g. "source BLOCKS target".
// The opposite label ("is blocked by") is derived when rendered from the
// target's side rather than stored as a second row. Cross-project links are
// allowed, same as Jira.
model IssueLink {
  id        String   @id @default(cuid())
  type      String   // "BLOCKS", "RELATES_TO", "DUPLICATES"
  sourceId  String
  source    Issue    @relation("IssueLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Issue    @relation("IssueLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

// A single entry of time spent on an issue. Logging work decrements the
// issue's remainingEstimateSeconds (auto-initialized from originalEstimate
// on the first log, mirroring Jira's default "reduce remaining estimate by
// the amount logged" behavior); deleting an entry restores it.
model Worklog {
  id               String   @id @default(cuid())
  issueId          String
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  timeSpentSeconds Int
  description      String?
  workDate         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([issueId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([issueId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastFour    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model Webhook {
  id          String            @id @default(cuid())
  name        String
  url         String
  secret      String?
  events      String            // JSON string array of events: ["issue:created", "issue:updated", ...]
  enabled     Boolean           @default(true)
  projectId   String?
  jqlFilter   String?           // Optional JQL filter expression for issue events
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
  @@index([enabled])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  url            String
  status         Int
  success        Boolean
  durationMs     Int
  requestPayload String   // Full JSON payload sent
  responseBody   String?  // Truncated response body received
  error          String?
  createdAt      DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

model SsoConfig {
  id                   String   @id @default("default")
  // Off until an administrator supplies key material to verify tokens with.
  enabled              Boolean  @default(false)
  providerName         String   @default("Enterprise SSO / SAML / OIDC")
  issuerUrl            String?  // IdP issuer, used for discovery and the `iss` claim check
  clientId             String?  // OIDC client id, checked against the `aud` claim
  clientSecret         String?  // Verifies HS* signed ID tokens
  certificate          String?  // PEM X.509 certificate, verifies RS* signed ID tokens
  // Deprecated: previously disabled TLS verification process-wide. Unused.
  allowSelfSignedCerts Boolean  @default(false)
  autoProvisionUsers   Boolean  @default(true) // Auto-create user on first SSO login
  // Linking an SSO login to an existing account needs the provider to mark the
  // email verified. Some (Microsoft Entra ID) never send the claim; an admin
  // who trusts theirs can turn this on.
  trustUnverifiedEmails Boolean @default(false)
  defaultRole          String   @default("Developer")
  updatedAt            DateTime @updatedAt
}





/// Instance-wide settings; a single row with id "default".
model InstanceSettings {
  id                    String   @id @default("default")
  // Whether anyone can create a local account from the sign-in page.
  allowSelfRegistration Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}
