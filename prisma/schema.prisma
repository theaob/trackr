datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  avatarUrl      String?
  role           String        @default("Developer")
  passwordHash   String?
  authProvider   String        @default("LOCAL") // "LOCAL", "SSO"
  ssoSubjectId   String?
  assignedIssues Issue[]       @relation("Assignee")
  reportedIssues Issue[]       @relation("Reporter")
  comments       Comment[]
  activityLogs   ActivityLog[]
  notifications       Notification[]
  ledProjects         Project[]
  projectMembers      ProjectMember[]
  personalAccessTokens PersonalAccessToken[]
  createdAt           DateTime      @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?
  category    String   @default("Software")
  // Grants VIEWER (read-only) access to visitors with no session. Off by
  // default: a project is private until someone deliberately publishes it.
  allowAnonymousViewers Boolean @default(false)
  leadId      String?
  lead        User?    @relation(fields: [leadId], references: [id])
  members     ProjectMember[]
  issues       Issue[]
  sprints      Sprint[]
  versions     Version[]
  customFields CustomField[]
  webhooks     Webhook[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // "ADMIN", "MEMBER", "VIEWER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  status    String    @default("FUTURE") // "FUTURE", "ACTIVE", "COMPLETED"
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Version {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("UNRELEASED") // "UNRELEASED", "RELEASED", "ARCHIVED"
  startDate   DateTime?
  releaseDate DateTime?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
}

model CustomField {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("TEXT") // "TEXT", "NUMBER", "SELECT", "MULTI_SELECT", "CHECKBOX", "DATE", "URL"
  options     String?  // JSON string array of options for SELECT / MULTI_SELECT
  required    Boolean  @default(false)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  issueId       String
  issue         Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([issueId, customFieldId])
  @@index([issueId])
  @@index([customFieldId])
}

model Issue {
  id          String        @id @default(cuid())
  key         String        @unique
  title       String
  description String?
  type        String        @default("TASK") // "EPIC", "STORY", "TASK", "BUG", "SUBTASK"
  priority    String        @default("MEDIUM") // "LOWEST", "LOW", "MEDIUM", "HIGH", "HIGHEST"
  status      String        @default("TODO") // "BACKLOG", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE"
  order       Int           @default(0)
  storyPoints Int?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  versionId   String?
  version     Version?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?         @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  String?
  reporter    User?         @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Issue?        @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Issue[]       @relation("IssueHierarchy")
  comments    Comment[]
  activityLogs ActivityLog[]
  customFieldValues CustomFieldValue[]
  linksAsSource IssueLink[] @relation("IssueLinkSource")
  linksAsTarget IssueLink[] @relation("IssueLinkTarget")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([projectId, versionId])
  @@index([projectId, createdAt])
  @@index([versionId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([type])
}

// A directional relationship between two issues, e.g. "source BLOCKS target".
// The opposite label ("is blocked by") is derived when rendered from the
// target's side rather than stored as a second row. Cross-project links are
// allowed, same as Jira.
model IssueLink {
  id        String   @id @default(cuid())
  type      String   // "BLOCKS", "RELATES_TO", "DUPLICATES"
  sourceId  String
  source    Issue    @relation("IssueLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Issue    @relation("IssueLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([issueId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastFour    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model Webhook {
  id          String            @id @default(cuid())
  name        String
  url         String
  secret      String?
  events      String            // JSON string array of events: ["issue:created", "issue:updated", ...]
  enabled     Boolean           @default(true)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
  @@index([enabled])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  url            String
  status         Int
  success        Boolean
  durationMs     Int
  requestPayload String   // Full JSON payload sent
  responseBody   String?  // Truncated response body received
  error          String?
  createdAt      DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

model SsoConfig {
  id                   String   @id @default("default")
  // Off until an administrator supplies key material to verify tokens with.
  enabled              Boolean  @default(false)
  providerName         String   @default("Enterprise SSO / SAML / OIDC")
  issuerUrl            String?  // IdP issuer, used for discovery and the `iss` claim check
  clientId             String?  // OIDC client id, checked against the `aud` claim
  clientSecret         String?  // Verifies HS* signed ID tokens
  certificate          String?  // PEM X.509 certificate, verifies RS* signed ID tokens
  // Deprecated: previously disabled TLS verification process-wide. Unused.
  allowSelfSignedCerts Boolean  @default(false)
  autoProvisionUsers   Boolean  @default(true) // Auto-create user on first SSO login
  defaultRole          String   @default("Developer")
  updatedAt            DateTime @updatedAt
}




